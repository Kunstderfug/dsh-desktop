{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "electron-vite/node", "vitest/globals"],
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsconfig-node.tsbuildinfo"
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "test/**/*.ts"
  ]
}
